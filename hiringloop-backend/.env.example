# Currently consumed by the backend runtime.
NODE_ENV=development
PORT=3000

# Local development database. Keep credentials local and never commit them.
DATABASE_URL=postgresql://hiringloop:password@localhost:5432/hiringloop_dev
# Isolated database reserved for database integration tests.
TEST_DATABASE_URL=postgresql://hiringloop:password@localhost:5432/hiringloop_test

# Reserved for future phases. These are documented only and are not required
# or connected to providers at the current foundation stage.
SESSION_SECRET=
REDIS_URL=
S3_BUCKET=
S3_REGION=
SENDGRID_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
