# Currently consumed by the backend runtime.
NODE_ENV=development
PORT=3000

# Local development database. Keep credentials local and never commit them.
DATABASE_URL=postgresql://hiringloop:password@localhost:5432/hiringloop_dev
# Isolated database reserved for database integration tests.
TEST_DATABASE_URL=postgresql://hiringloop:password@localhost:5432/hiringloop_test

# Browser origin used by CORS and auth links. Use the exact frontend origin.
FRONTEND_ORIGIN=http://localhost:5173

# Dedicated HMAC key for authenticated synchronizer CSRF tokens. Required in
# development and production; use at least 32 characters. Never put backend
# secrets in VITE_* frontend variables.
AUTH_CSRF_SECRET=

# Optional in local development unless actual email testing is desired. Set
# both SendGrid-specific values (and FRONTEND_ORIGIN) to enable delivery.
SENDGRID_API_KEY=
AUTH_EMAIL_FROM=

# Optional outside production. Set all three to enable Google OIDC identity login.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Reserved for future phases.
SESSION_SECRET=
REDIS_URL=
S3_BUCKET=
S3_REGION=
