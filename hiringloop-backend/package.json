{
  "name": "hiringloop-backend",
  "version": "1.0.0",
  "description": "HiringLoop backend application",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "oxlint src",
    "format": "prettier src package.json .oxlintrc.json .prettierrc.json --write",
    "format:check": "prettier src tests vitest.config.js package.json .oxlintrc.json .prettierrc.json --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run format:check && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
