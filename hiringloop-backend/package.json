{
  "name": "hiringloop-backend",
  "version": "1.0.0",
  "description": "HiringLoop backend application",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "oxlint src",
    "format": "prettier src prisma.config.js package.json .oxlintrc.json .prettierrc.json --write",
    "format:check": "prettier src tests prisma.config.js vitest.config.js package.json .oxlintrc.json .prettierrc.json --check",
    "test": "vitest run --exclude tests/integration/**",
    "test:db": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/database",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "verify": "npm run lint && npm run format:check && npm run test",
    "verify:db": "npm run prisma:validate && npm run test:db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sendgrid/mail": "^8.1.6",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
