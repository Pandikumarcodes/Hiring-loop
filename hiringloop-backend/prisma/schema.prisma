generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 02 first tenant foundation slice.
// IDs are required application inputs generated with UUIDv7 by src/utils/ids.js.
// The migration task must add a PostgreSQL CHECK for ADMIN, RECRUITER,
// HIRING_MANAGER, and INTERVIEWER role values.

model User {
  id                      String                   @id @db.Uuid
  email                   String                   @unique
  emailVerifiedAt         DateTime?                @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  passwordCredential      PasswordCredential?
  authSessions            AuthSession[]
  authTokens              AuthToken[]
  authProviderIdentities  AuthProviderIdentity[]
  organizationMemberships OrganizationMembership[]
}

model PasswordCredential {
  id                String   @id @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

model AuthSession {
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  sessionSecretHash String    @unique
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id         String           @id @db.Uuid
  userId     String           @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime         @db.Timestamptz(6)
  consumedAt DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

model AuthProviderIdentity {
  id              String   @id @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Organization {
  id          String                   @id @db.Uuid
  name        String
  slug        String                   @unique @db.VarChar(63)
  website     String?
  description String?
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)
  memberships OrganizationMembership[]
  invitations Invitation[]
  jobs        Job[]
  applicationForms ApplicationForm[]
  applicationFormVersions ApplicationFormVersion[]
  applicationFormQuestions ApplicationFormQuestion[]
  applicationFormQuestionOptions ApplicationFormQuestionOption[]
  candidates Candidate[]
  applications Application[]
  applicationAnswers ApplicationAnswer[]
  candidateDocuments CandidateDocument[]
  applicationUploads ApplicationUpload[]
  applicationStageHistories ApplicationStageHistory[]
}

model OrganizationMembership {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @db.VarChar(32)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sentInvitations Invitation[] @relation("InvitationInviterMembership")

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id                  String    @id @db.Uuid
  organizationId      String    @db.Uuid
  email               String    @db.VarChar(320)
  role                String    @db.VarChar(32)
  tokenHash           String    @unique
  expiresAt           DateTime  @db.Timestamptz(6)
  acceptedAt          DateTime? @db.Timestamptz(6)
  revokedAt           DateTime? @db.Timestamptz(6)
  inviterMembershipId String    @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inviterMembership OrganizationMembership @relation("InvitationInviterMembership", fields: [inviterMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, createdAt])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  OTHER
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum PipelineStageKind {
  ENTRY
  STANDARD
}

model Job {
  id             String          @id @db.Uuid
  organizationId String          @db.Uuid
  title          String          @db.VarChar(160)
  department     String?         @db.VarChar(100)
  employmentType EmploymentType?
  workplaceType  WorkplaceType?
  location       String?         @db.VarChar(160)
  description    String?         @db.Text
  openings       Int             @default(1)
  status         JobStatus       @default(DRAFT)
  openedAt       DateTime?       @db.Timestamptz(6)
  closedAt       DateTime?       @db.Timestamptz(6)
  archivedAt     DateTime?       @db.Timestamptz(6)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pipeline     Pipeline?
  applicationForm ApplicationForm?
  applications Application[]
  applicationUploads ApplicationUpload[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, status, openedAt])
}

model Pipeline {
  id        String   @id @db.Uuid
  jobId     String   @unique @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  job    Job             @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stages PipelineStage[]
}

model PipelineStage {
  id             String            @id @db.Uuid
  pipelineId     String            @db.Uuid
  name           String            @db.VarChar(80)
  normalizedName String            @db.VarChar(80)
  kind           PipelineStageKind
  position       Int
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentApplications Application[] @relation("ApplicationCurrentStage")
  stageHistoryTo ApplicationStageHistory[] @relation("ApplicationStageHistoryTo")
  stageHistoryFrom ApplicationStageHistory[] @relation("ApplicationStageHistoryFrom")

  @@unique([pipelineId, position])
  @@unique([pipelineId, normalizedName])
}

enum ApplicationFormVersionStatus {
  DRAFT
  PUBLISHED
}

enum ApplicationFormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  YES_NO
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  URL
}

model ApplicationForm {
  id              String @id @db.Uuid
  organizationId  String @db.Uuid
  jobId           String @unique @db.Uuid
  activeVersionId String @unique @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job          Job @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeVersion ApplicationFormVersion @relation("ApplicationFormActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions     ApplicationFormVersion[] @relation("ApplicationFormVersions")

  @@index([organizationId, jobId])
}

model ApplicationFormVersion {
  id                String @id @db.Uuid
  organizationId    String @db.Uuid
  applicationFormId String @db.Uuid
  versionNumber     Int
  status            ApplicationFormVersionStatus
  revision          Int @default(1)
  publishedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applicationForm ApplicationForm @relation("ApplicationFormVersions", fields: [applicationFormId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFor ApplicationForm? @relation("ApplicationFormActiveVersion")
  questions ApplicationFormQuestion[]
  applications Application[]

  @@unique([applicationFormId, versionNumber])
  @@index([applicationFormId, status])
}

model ApplicationFormQuestion {
  id                       String @id @db.Uuid
  organizationId           String @db.Uuid
  applicationFormVersionId String @db.Uuid
  questionKey              String @db.VarChar(100)
  type                     ApplicationFormQuestionType
  label                    String @db.VarChar(500)
  description              String? @db.Text
  placeholder              String? @db.VarChar(500)
  required                 Boolean @default(false)
  sortOrder                Int
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applicationFormVersion ApplicationFormVersion @relation(fields: [applicationFormVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  options ApplicationFormQuestionOption[]
  answers ApplicationAnswer[]

  @@unique([applicationFormVersionId, questionKey])
  @@index([applicationFormVersionId, sortOrder])
}

model ApplicationFormQuestionOption {
  id             String @id @db.Uuid
  organizationId String @db.Uuid
  questionId     String @db.Uuid
  label          String @db.VarChar(500)
  value          String @db.VarChar(200)
  sortOrder      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  question ApplicationFormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([questionId, value])
  @@index([questionId, sortOrder])
}

enum CandidateDocumentType {
  RESUME
}

enum ApplicationUploadStatus {
  PENDING
  CONSUMED
  EXPIRED
}

model Candidate {
  id              String   @id @db.Uuid
  organizationId  String   @db.Uuid
  normalizedEmail String   @db.VarChar(320)
  email           String   @db.VarChar(320)
  firstName       String   @db.VarChar(100)
  lastName        String   @db.VarChar(100)
  phone           String?  @db.VarChar(50)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applications Application[]
  documents CandidateDocument[]

  @@unique([organizationId, normalizedEmail])
  @@unique([id, organizationId])
}

model Application {
  id                       String   @id @db.Uuid
  organizationId           String   @db.Uuid
  jobId                    String   @db.Uuid
  candidateId              String   @db.Uuid
  applicationFormVersionId String   @db.Uuid
  currentPipelineStageId   String   @db.Uuid
  submittedFirstName       String   @db.VarChar(100)
  submittedLastName        String   @db.VarChar(100)
  submittedEmail           String   @db.VarChar(320)
  submittedPhone           String?  @db.VarChar(50)
  idempotencyKey           String   @db.Uuid
  requestFingerprint       String   @db.Char(64)
  submittedAt              DateTime @default(now()) @db.Timestamptz(6)
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job          Job                    @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidate    Candidate              @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  formVersion  ApplicationFormVersion @relation(fields: [applicationFormVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentStage PipelineStage          @relation("ApplicationCurrentStage", fields: [currentPipelineStageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  answers      ApplicationAnswer[]
  documents    CandidateDocument[]
  stageHistory ApplicationStageHistory[]
  consumedUpload ApplicationUpload? @relation("ConsumedApplicationUpload")

  @@unique([organizationId, jobId, candidateId])
  @@unique([organizationId, jobId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, jobId, submittedAt])
  @@index([applicationFormVersionId])
  @@index([currentPipelineStageId])
}

model ApplicationAnswer {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  questionId     String   @db.Uuid
  value          Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application             @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  question     ApplicationFormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([applicationId, questionId])
  @@index([questionId])
}

model CandidateDocument {
  id               String                @id @db.Uuid
  organizationId   String                @db.Uuid
  candidateId      String                @db.Uuid
  applicationId    String                @db.Uuid
  type             CandidateDocumentType
  objectKey        String                @unique @db.VarChar(512)
  originalFilename String                @db.VarChar(255)
  mimeType         String                @db.VarChar(127)
  sizeBytes        Int
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, candidateId])
  @@index([applicationId])
}

model ApplicationUpload {
  id                    String                  @id @db.Uuid
  organizationId        String                  @db.Uuid
  jobId                 String                  @db.Uuid
  objectKey             String                  @unique @db.VarChar(512)
  originalFilename      String                  @db.VarChar(255)
  mimeType              String                  @db.VarChar(127)
  declaredSizeBytes     Int
  status                ApplicationUploadStatus @default(PENDING)
  expiresAt             DateTime                @db.Timestamptz(6)
  consumedAt            DateTime?               @db.Timestamptz(6)
  consumedApplicationId String?                 @unique @db.Uuid
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                 Job          @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumedApplication Application? @relation("ConsumedApplicationUpload", fields: [consumedApplicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, jobId, status, expiresAt])
  @@index([expiresAt])
}

model ApplicationStageHistory {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  fromStageId    String?  @db.Uuid
  toStageId      String   @db.Uuid
  event          String   @db.VarChar(64)
  occurredAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromStage    PipelineStage? @relation("ApplicationStageHistoryFrom", fields: [fromStageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toStage      PipelineStage  @relation("ApplicationStageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([applicationId, occurredAt])
}
