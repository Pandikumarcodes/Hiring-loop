generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 02 first tenant foundation slice.
// IDs are required application inputs generated with UUIDv7 by src/utils/ids.js.
// The migration task must add a PostgreSQL CHECK for ADMIN, RECRUITER,
// HIRING_MANAGER, and INTERVIEWER role values.

model User {
  id                      String                   @id @db.Uuid
  email                   String                   @unique
  emailVerifiedAt         DateTime?                @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  passwordCredential      PasswordCredential?
  authSessions            AuthSession[]
  authTokens              AuthToken[]
  authProviderIdentities  AuthProviderIdentity[]
  organizationMemberships OrganizationMembership[]
  createdInterviews       Interview[]              @relation("InterviewCreatedBy")
  cancelledInterviews     Interview[]              @relation("InterviewCancelledBy")
  interviewParticipants   InterviewParticipant[]
  authoredNotes           Note[]                   @relation("NoteAuthor")
  createdCommunications   Communication[]          @relation("CommunicationCreatedBy")
  createdCommunicationTemplates CommunicationTemplate[] @relation("CommunicationTemplateCreatedBy")
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[]
  createdOffers Offer[] @relation("OfferCreatedBy")
  offerAcceptances Offer[] @relation("OfferAcceptedBy")
  offerDeclines Offer[] @relation("OfferDeclinedBy")
  offerWithdrawals Offer[] @relation("OfferWithdrawnBy")
  createdOfferVersions OfferVersion[] @relation("OfferVersionCreatedBy")
  outcomeEvents ApplicationOutcomeEvent[]
  createdTalentPools TalentPool[] @relation("TalentPoolCreatedBy")
  addedTalentPoolMembers TalentPoolMember[] @relation("TalentPoolMemberAddedBy")
}

model PasswordCredential {
  id                String   @id @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

model AuthSession {
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  sessionSecretHash String    @unique
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id         String           @id @db.Uuid
  userId     String           @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime         @db.Timestamptz(6)
  consumedAt DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

model AuthProviderIdentity {
  id              String   @id @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Organization {
  id          String                   @id @db.Uuid
  name        String
  slug        String                   @unique @db.VarChar(63)
  website     String?
  description String?
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)
  memberships OrganizationMembership[]
  invitations Invitation[]
  jobs        Job[]
  applicationForms ApplicationForm[]
  applicationFormVersions ApplicationFormVersion[]
  applicationFormQuestions ApplicationFormQuestion[]
  applicationFormQuestionOptions ApplicationFormQuestionOption[]
  candidates Candidate[]
  applications Application[]
  applicationAnswers ApplicationAnswer[]
  candidateDocuments CandidateDocument[]
  applicationUploads ApplicationUpload[]
  applicationStageHistories ApplicationStageHistory[]
  interviews Interview[]
  scorecardTemplates ScorecardTemplate[]
  scorecardTemplateVersions ScorecardTemplateVersion[]
  scorecardCriteria ScorecardCriterion[]
  scorecards Scorecard[]
  scorecardResponses ScorecardResponse[]
  notes Note[]
  communications Communication[]
  communicationTemplates CommunicationTemplate[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  offers Offer[]
  offerVersions OfferVersion[]
  outcomeEvents ApplicationOutcomeEvent[]
  talentPools TalentPool[]
  talentPoolMembers TalentPoolMember[]
}

model OrganizationMembership {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @db.VarChar(32)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sentInvitations Invitation[] @relation("InvitationInviterMembership")
  notificationPreferences NotificationPreference[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id                  String    @id @db.Uuid
  organizationId      String    @db.Uuid
  email               String    @db.VarChar(320)
  role                String    @db.VarChar(32)
  tokenHash           String    @unique
  expiresAt           DateTime  @db.Timestamptz(6)
  acceptedAt          DateTime? @db.Timestamptz(6)
  revokedAt           DateTime? @db.Timestamptz(6)
  inviterMembershipId String    @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inviterMembership OrganizationMembership @relation("InvitationInviterMembership", fields: [inviterMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, createdAt])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  OTHER
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum PipelineStageKind {
  ENTRY
  STANDARD
}

model Job {
  id             String          @id @db.Uuid
  organizationId String          @db.Uuid
  title          String          @db.VarChar(160)
  department     String?         @db.VarChar(100)
  employmentType EmploymentType?
  workplaceType  WorkplaceType?
  location       String?         @db.VarChar(160)
  description    String?         @db.Text
  openings       Int             @default(1)
  status         JobStatus       @default(DRAFT)
  openedAt       DateTime?       @db.Timestamptz(6)
  closedAt       DateTime?       @db.Timestamptz(6)
  archivedAt     DateTime?       @db.Timestamptz(6)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pipeline     Pipeline?
  applicationForm ApplicationForm?
  applications Application[]
  applicationUploads ApplicationUpload[]
  scorecardTemplate ScorecardTemplate?

  @@index([organizationId, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, status, openedAt])
}

model Pipeline {
  id        String   @id @db.Uuid
  jobId     String   @unique @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  job    Job             @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stages PipelineStage[]
}

model PipelineStage {
  id             String            @id @db.Uuid
  pipelineId     String            @db.Uuid
  name           String            @db.VarChar(80)
  normalizedName String            @db.VarChar(80)
  kind           PipelineStageKind
  position       Int
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentApplications Application[] @relation("ApplicationCurrentStage")
  stageHistoryTo ApplicationStageHistory[] @relation("ApplicationStageHistoryTo")
  stageHistoryFrom ApplicationStageHistory[] @relation("ApplicationStageHistoryFrom")

  @@unique([pipelineId, position])
  @@unique([pipelineId, normalizedName])
}

enum ApplicationFormVersionStatus {
  DRAFT
  PUBLISHED
}

enum ApplicationFormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  YES_NO
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  URL
}

model ApplicationForm {
  id              String @id @db.Uuid
  organizationId  String @db.Uuid
  jobId           String @unique @db.Uuid
  activeVersionId String @unique @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job          Job @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeVersion ApplicationFormVersion @relation("ApplicationFormActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions     ApplicationFormVersion[] @relation("ApplicationFormVersions")

  @@index([organizationId, jobId])
}

model ApplicationFormVersion {
  id                String @id @db.Uuid
  organizationId    String @db.Uuid
  applicationFormId String @db.Uuid
  versionNumber     Int
  status            ApplicationFormVersionStatus
  revision          Int @default(1)
  publishedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applicationForm ApplicationForm @relation("ApplicationFormVersions", fields: [applicationFormId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFor ApplicationForm? @relation("ApplicationFormActiveVersion")
  questions ApplicationFormQuestion[]
  applications Application[]

  @@unique([applicationFormId, versionNumber])
  @@index([applicationFormId, status])
}

model ApplicationFormQuestion {
  id                       String @id @db.Uuid
  organizationId           String @db.Uuid
  applicationFormVersionId String @db.Uuid
  questionKey              String @db.VarChar(100)
  type                     ApplicationFormQuestionType
  label                    String @db.VarChar(500)
  description              String? @db.Text
  placeholder              String? @db.VarChar(500)
  required                 Boolean @default(false)
  sortOrder                Int
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applicationFormVersion ApplicationFormVersion @relation(fields: [applicationFormVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  options ApplicationFormQuestionOption[]
  answers ApplicationAnswer[]

  @@unique([applicationFormVersionId, questionKey])
  @@index([applicationFormVersionId, sortOrder])
}

model ApplicationFormQuestionOption {
  id             String @id @db.Uuid
  organizationId String @db.Uuid
  questionId     String @db.Uuid
  label          String @db.VarChar(500)
  value          String @db.VarChar(200)
  sortOrder      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  question ApplicationFormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([questionId, value])
  @@index([questionId, sortOrder])
}

enum CandidateDocumentType {
  RESUME
}

enum ApplicationUploadStatus {
  PENDING
  CONSUMED
  EXPIRED
}

model Candidate {
  id              String   @id @db.Uuid
  organizationId  String   @db.Uuid
  normalizedEmail String   @db.VarChar(320)
  email           String   @db.VarChar(320)
  firstName       String   @db.VarChar(100)
  lastName        String   @db.VarChar(100)
  phone           String?  @db.VarChar(50)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applications Application[]
  documents CandidateDocument[]
  talentPoolMembers TalentPoolMember[]

  @@unique([organizationId, normalizedEmail])
  @@unique([id, organizationId])
}

model Application {
  id                       String   @id @db.Uuid
  organizationId           String   @db.Uuid
  jobId                    String   @db.Uuid
  candidateId              String   @db.Uuid
  applicationFormVersionId String   @db.Uuid
  currentPipelineStageId   String   @db.Uuid
  submittedFirstName       String   @db.VarChar(100)
  submittedLastName        String   @db.VarChar(100)
  submittedEmail           String   @db.VarChar(320)
  submittedPhone           String?  @db.VarChar(50)
  idempotencyKey           String   @db.Uuid
  requestFingerprint       String   @db.Char(64)
  outcome                  ApplicationOutcome @default(ACTIVE)
  outcomeUpdatedAt         DateTime @default(now()) @db.Timestamptz(6)
  outcomeRevision          Int @default(1)
  submittedAt              DateTime @default(now()) @db.Timestamptz(6)
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job          Job                    @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidate    Candidate              @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  formVersion  ApplicationFormVersion @relation(fields: [applicationFormVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentStage PipelineStage          @relation("ApplicationCurrentStage", fields: [currentPipelineStageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  answers      ApplicationAnswer[]
  documents    CandidateDocument[]
  stageHistory ApplicationStageHistory[]
  interviews   Interview[]
  consumedUpload ApplicationUpload? @relation("ConsumedApplicationUpload")
  notes Note[]
  communications Communication[]
  notifications Notification[]
  offer Offer?
  outcomeEvents ApplicationOutcomeEvent[]
  talentPoolMembershipSources TalentPoolMember[] @relation("TalentPoolMemberSourceApplication")

  @@unique([organizationId, jobId, candidateId])
  @@unique([organizationId, jobId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, jobId, submittedAt])
  @@index([applicationFormVersionId])
  @@index([currentPipelineStageId])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}
enum ApplicationOutcome {
  ACTIVE
  HIRED
  REJECTED
}
enum ApplicationOutcomeEventType {
  HIRED
  REJECTED
  REOPENED
}

model Offer {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  applicationId String @unique @db.Uuid
  status OfferStatus @default(DRAFT)
  currentVersionId String? @unique @db.Uuid
  createdByUserId String @db.Uuid
  sentAt DateTime? @db.Timestamptz(6)
  acceptedAt DateTime? @db.Timestamptz(6)
  declinedAt DateTime? @db.Timestamptz(6)
  withdrawnAt DateTime? @db.Timestamptz(6)
  acceptedByUserId String? @db.Uuid
  declinedByUserId String? @db.Uuid
  withdrawnByUserId String? @db.Uuid
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  application Application @relation(fields:[applicationId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  currentVersion OfferVersion? @relation("OfferCurrentVersion", fields:[currentVersionId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  versions OfferVersion[] @relation("OfferVersions")
  createdBy User @relation("OfferCreatedBy", fields:[createdByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy User? @relation("OfferAcceptedBy", fields:[acceptedByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  declinedBy User? @relation("OfferDeclinedBy", fields:[declinedByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  withdrawnBy User? @relation("OfferWithdrawnBy", fields:[withdrawnByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([id, organizationId])
  @@unique([applicationId, organizationId])
  @@index([organizationId, applicationId])
}

model OfferVersion {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  offerId String @db.Uuid
  versionNumber Int
  jobTitle String @db.VarChar(160)
  currency String @db.Char(3)
  baseCompensationMinor BigInt @db.BigInt
  bonusCompensationMinor BigInt? @db.BigInt
  additionalCompensationText String? @db.Text
  startDate DateTime? @db.Date
  expirationDate DateTime? @db.Date
  location String? @db.VarChar(160)
  workplaceType WorkplaceType?
  additionalTerms String? @db.Text
  revision Int @default(1)
  issuedAt DateTime? @db.Timestamptz(6)
  createdByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  offer Offer @relation("OfferVersions", fields:[offerId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  currentFor Offer? @relation("OfferCurrentVersion")
  createdBy User @relation("OfferVersionCreatedBy", fields:[createdByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  communications Communication[]
  @@unique([offerId, versionNumber])
  @@unique([id, organizationId])
  @@index([offerId, versionNumber])
}

model ApplicationOutcomeEvent {
 id String @id @db.Uuid
 organizationId String @db.Uuid
 applicationId String @db.Uuid
 type ApplicationOutcomeEventType
 reasonCode String? @db.VarChar(64)
 reasonDetails String? @db.VarChar(1000)
 actorUserId String @db.Uuid
 occurredAt DateTime @default(now()) @db.Timestamptz(6)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
 application Application @relation(fields:[applicationId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
 actor User @relation(fields:[actorUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
 @@index([applicationId, occurredAt, id])
}

model TalentPool {
 id String @id @db.Uuid
 organizationId String @db.Uuid
 name String @db.VarChar(160)
 description String? @db.VarChar(1000)
 createdByUserId String @db.Uuid
 revision Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
 createdBy User @relation("TalentPoolCreatedBy", fields:[createdByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
 members TalentPoolMember[]
 @@unique([organizationId, name])
 @@unique([id, organizationId])
 @@index([organizationId, name, id])
}

model TalentPoolMember {
 id String @id @db.Uuid
 organizationId String @db.Uuid
 talentPoolId String @db.Uuid
 candidateId String @db.Uuid
 sourceApplicationId String? @db.Uuid
 addedByUserId String @db.Uuid
 note String? @db.VarChar(1000)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
 talentPool TalentPool @relation(fields:[talentPoolId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
 candidate Candidate @relation(fields:[candidateId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
 sourceApplication Application? @relation("TalentPoolMemberSourceApplication", fields:[sourceApplicationId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
 addedBy User @relation("TalentPoolMemberAddedBy", fields:[addedByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
 @@unique([talentPoolId, candidateId])
 @@index([talentPoolId, createdAt, id])
 @@index([organizationId, candidateId])
}

model ApplicationAnswer {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  questionId     String   @db.Uuid
  value          Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application             @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  question     ApplicationFormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([applicationId, questionId])
  @@index([questionId])
}

model CandidateDocument {
  id               String                @id @db.Uuid
  organizationId   String                @db.Uuid
  candidateId      String                @db.Uuid
  applicationId    String                @db.Uuid
  type             CandidateDocumentType
  objectKey        String                @unique @db.VarChar(512)
  originalFilename String                @db.VarChar(255)
  mimeType         String                @db.VarChar(127)
  sizeBytes        Int
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, candidateId])
  @@index([applicationId])
}

model ApplicationUpload {
  id                    String                  @id @db.Uuid
  organizationId        String                  @db.Uuid
  jobId                 String                  @db.Uuid
  objectKey             String                  @unique @db.VarChar(512)
  originalFilename      String                  @db.VarChar(255)
  mimeType              String                  @db.VarChar(127)
  declaredSizeBytes     Int
  status                ApplicationUploadStatus @default(PENDING)
  expiresAt             DateTime                @db.Timestamptz(6)
  consumedAt            DateTime?               @db.Timestamptz(6)
  consumedApplicationId String?                 @unique @db.Uuid
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                 Job          @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumedApplication Application? @relation("ConsumedApplicationUpload", fields: [consumedApplicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, jobId, status, expiresAt])
  @@index([expiresAt])
}

model ApplicationStageHistory {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  fromStageId    String?  @db.Uuid
  toStageId      String   @db.Uuid
  event          String   @db.VarChar(64)
  occurredAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromStage    PipelineStage? @relation("ApplicationStageHistoryFrom", fields: [fromStageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toStage      PipelineStage  @relation("ApplicationStageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([applicationId, occurredAt])
}

enum InterviewFormat {
  VIDEO
  PHONE
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  CANCELLED
}

model Interview {
  id                 String          @id @db.Uuid
  organizationId     String          @db.Uuid
  applicationId      String          @db.Uuid
  title              String          @db.VarChar(160)
  format             InterviewFormat
  scheduledStartAt   DateTime        @db.Timestamptz(6)
  scheduledEndAt     DateTime        @db.Timestamptz(6)
  timeZone           String          @db.VarChar(64)
  meetingUrl         String?         @db.VarChar(2048)
  location           String?         @db.VarChar(240)
  status             InterviewStatus @default(SCHEDULED)
  cancelledAt        DateTime?       @db.Timestamptz(6)
  cancelledByUserId  String?         @db.Uuid
  cancellationReason String?         @db.VarChar(500)
  createdByUserId    String          @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application  Application  @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  participants InterviewParticipant[]
  createdBy    User         @relation("InterviewCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy  User?        @relation("InterviewCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scorecards Scorecard[]
  notifications Notification[]

  @@unique([id, organizationId])
  @@index([organizationId, scheduledStartAt])
  @@index([applicationId, scheduledStartAt])
}

model InterviewParticipant {
  id          String   @id @db.Uuid
  interviewId String   @db.Uuid
  userId      String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scorecard Scorecard?

  @@unique([interviewId, userId])
  @@index([userId, interviewId])
}

enum ScorecardTemplateVersionStatus {
  DRAFT
  PUBLISHED
}
enum ScorecardCriterionType {
  RATING
  TEXT
}
enum ScorecardStatus {
  DRAFT
  SUBMITTED
}
enum ScorecardRecommendation {
  STRONG_NO
  NO
  MIXED
  YES
  STRONG_YES
}

model ScorecardTemplate {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  jobId String @unique @db.Uuid
  activeVersionId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeVersion ScorecardTemplateVersion? @relation("ScorecardTemplateActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions ScorecardTemplateVersion[] @relation("ScorecardTemplateVersions")
  @@index([organizationId, jobId])
}

model ScorecardTemplateVersion {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  templateId String @db.Uuid
  versionNumber Int
  status ScorecardTemplateVersionStatus
  title String @db.VarChar(160)
  instructions String? @db.Text
  revision Int @default(1)
  publishedAt DateTime? @db.Timestamptz(6)
  createdByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  template ScorecardTemplate @relation("ScorecardTemplateVersions", fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFor ScorecardTemplate? @relation("ScorecardTemplateActiveVersion")
  criteria ScorecardCriterion[]
  scorecards Scorecard[]
  @@unique([templateId, versionNumber])
  @@index([templateId, status])
}

model ScorecardCriterion {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  templateVersionId String @db.Uuid
  label String @db.VarChar(300)
  description String? @db.Text
  type ScorecardCriterionType
  required Boolean @default(false)
  position Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  templateVersion ScorecardTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responses ScorecardResponse[]
  @@unique([templateVersionId, position])
}

model Scorecard {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  interviewId String @db.Uuid
  interviewParticipantId String @unique @db.Uuid
  templateVersionId String @db.Uuid
  status ScorecardStatus @default(DRAFT)
  overallRecommendation ScorecardRecommendation?
  overallComment String? @db.Text
  revision Int @default(1)
  submittedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participant InterviewParticipant @relation(fields: [interviewParticipantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  templateVersion ScorecardTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responses ScorecardResponse[]
  @@index([organizationId, interviewId, status])
  @@index([interviewId])
}

model ScorecardResponse {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  scorecardId String @db.Uuid
  criterionId String @db.Uuid
  ratingValue Int?
  textValue String? @db.Text
  comment String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scorecard Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criterion ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([scorecardId, criterionId])
}

model Note {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  applicationId String @db.Uuid
  authorUserId String @db.Uuid
  body String @db.Text
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author User @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([organizationId, applicationId, createdAt])
}

enum CommunicationChannel {
  EMAIL
}
enum CommunicationDirection {
  OUTBOUND
}
enum CommunicationStatus {
  PENDING
  SENT
  FAILED
}
enum NotificationType {
  CANDIDATE_COMMUNICATION_FAILED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
  SCORECARD_SUBMITTED
}

model Communication {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  applicationId String @db.Uuid
  createdByUserId String @db.Uuid
  channel CommunicationChannel @default(EMAIL)
  direction CommunicationDirection @default(OUTBOUND)
  recipientEmail String @db.VarChar(320)
  subject String @db.VarChar(998)
  body String @db.Text
  status CommunicationStatus @default(PENDING)
  provider String @db.VarChar(32)
  providerMessageId String? @db.VarChar(255)
  failureCategory String? @db.VarChar(64)
  idempotencyKey String @db.Uuid
  payloadHash String @db.VarChar(64)
  offerVersionId String? @db.Uuid
  sentAt DateTime? @db.Timestamptz(6)
  failedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  application Application @relation(fields:[applicationId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("CommunicationCreatedBy", fields:[createdByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  offerVersion OfferVersion? @relation(fields:[offerVersionId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, applicationId, createdByUserId, idempotencyKey])
  @@index([organizationId, applicationId, createdAt, id])
}

model CommunicationTemplate {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  name String @db.VarChar(160)
  subject String @db.VarChar(998)
  body String @db.Text
  createdByUserId String @db.Uuid
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("CommunicationTemplateCreatedBy", fields:[createdByUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model Notification {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  recipientUserId String @db.Uuid
  type NotificationType
  title String @db.VarChar(160)
  message String @db.VarChar(1000)
  applicationId String? @db.Uuid
  interviewId String? @db.Uuid
  readAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  recipient User @relation("NotificationRecipient", fields:[recipientUserId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  application Application? @relation(fields:[applicationId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  interview Interview? @relation(fields:[interviewId, organizationId], references:[id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  @@index([organizationId, recipientUserId, createdAt, id])
}

model NotificationPreference {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  userId String @db.Uuid
  notificationType NotificationType
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields:[userId], references:[id], onDelete: Restrict, onUpdate: Restrict)
  membership OrganizationMembership @relation(fields:[organizationId, userId], references:[organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  @@unique([organizationId, userId, notificationType])
}
